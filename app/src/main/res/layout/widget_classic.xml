<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_classic_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_art">

    <!-- Frosted liquid glass backdrop with blurred album cover & specular rim -->
    <ImageView
        android:id="@+id/widget_classic_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_artwork"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/widget_classic_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_preview_title"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/widget_classic_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/sf_pro_display_regular"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_preview_artist"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_classic_previous"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_transport_button"
                android:contentDescription="@string/widget_previous"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_previous" />

            <ImageView
                android:id="@+id/widget_classic_toggle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/widget_transport_button"
                android:contentDescription="@string/widget_play"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_play" />

            <ImageView
                android:id="@+id/widget_classic_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_transport_button"
                android:contentDescription="@string/widget_next"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
