<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_m3_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_pill_background">

    <ImageView
        android:id="@+id/widget_m3_art_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_artwork"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/widget_m3_cover"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:contentDescription="@string/widget_artwork"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_pill_art_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_m3_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/sf_pro_display_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_preview_title"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/widget_m3_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="@font/sf_pro_display_medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_preview_artist"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_m3_previous"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/widget_transport_button"
                android:contentDescription="@string/widget_previous"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_previous" />

            <ImageView
                android:id="@+id/widget_m3_toggle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_transport_button"
                android:contentDescription="@string/widget_play"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_play" />

            <ImageView
                android:id="@+id/widget_m3_next"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_transport_button"
                android:contentDescription="@string/widget_next"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
