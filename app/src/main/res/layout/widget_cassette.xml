<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_cassette_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_art">

    <!-- The custom rendered cassette tape, reels, card, and typography -->
    <ImageView
        android:id="@+id/widget_cassette_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_artwork"
        android:scaleType="fitXY" />

    <!-- Vintage tactile physical deck buttons at the bottom right/center -->
    <LinearLayout
        android:id="@+id/widget_cassette_deck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_cassette_prev"
            android:layout_width="38dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_deck_button"
            android:contentDescription="@string/widget_previous"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_previous" />

        <ImageView
            android:id="@+id/widget_cassette_toggle"
            android:layout_width="44dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_deck_play_button"
            android:contentDescription="@string/widget_play"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_play" />

        <ImageView
            android:id="@+id/widget_cassette_next"
            android:layout_width="38dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_deck_button"
            android:contentDescription="@string/widget_next"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_next" />
    </LinearLayout>
</FrameLayout>
